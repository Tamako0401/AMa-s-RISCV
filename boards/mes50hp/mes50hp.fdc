# OV7670 SCCB (J8_21 SCL / J8_22 SDA) 是开漏总线, 要靠上拉才能收到 ACK。
# 摄像头模块上不一定带上拉电阻; 打开 FPGA 内部上拉, 否则 SDA 悬空被读成 0,
# ACK 检测会假通过 —— 看起来"配置成功", 其实一条寄存器都没写进去。
define_attribute {p:io[18]} {PAP_IO_PULLUP} {TRUE}
define_attribute {p:io[19]} {PAP_IO_PULLUP} {TRUE}
