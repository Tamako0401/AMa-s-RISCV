# 复制成 ama.local.toml 再改 (不提交)。全部可省, 整个文件也可以没有。
#
# 工具: 键名是 ama 调用的程序名, 值是替代它的命令 (字符串列表)。没写的就在 PATH 里找同名程序。
#   可写的键: riscv32-unknown-elf-gcc, cc, verilator, vivado, pds_shell, cdt_cfg_shell (PDS 的下载工具)
#             ruff, clang-tidy, clang-format, verible-verilog-lint, verible-verilog-format
# 替代命令必须表现得和原程序一样:
#   - ama 在值后面追加原程序自己的参数, 替代命令要原样接受;
#   - ama 选定当前目录 (仓库根或 build/ 下的工程目录) 再运行, 替代命令要在这个目录里读写, 认相对路径;
#   - 输出写到 stdout/stderr, 成功返回 0, 失败返回非 0。
# 只要版本、参数、输入相同, 不同机器上的结果就该相同; `ama doctor` 列出各工具的命令和版本。
# Windows 路径用单引号 (TOML 字面量字符串), 反斜杠不用转义。
# 写了不认识的键, ama 直接报错。
#
# vivado = ["..."]

# 认不出板子时用的板子 (ego1/mes50hp/mes2l100hp; 两块盘古串口芯片相同, 只插一块盘古时也靠它区分)
# board = "ego1"

# 运行工具前加的环境变量
# [env]
# NAME = "value"
